# Copy this file to server/.env and fill in your own values.
# Never commit server/.env or share its credentials in chat.
NODE_ENV=development
PORT=5000
MONGODB_URI=your-mongodb-connection-string
JWT_SECRET=replace-with-a-long-random-secret-before-deployment
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Gmail SMTP email notifications. Use a Google App Password, never your normal password.
GMAIL_USER=your-campusfix-sender@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# Cloudinary image storage. Keep the API secret on the server only.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional comma-separated VIT Bhopal program-code allow-list, e.g. CSE,ECE
# Leave blank to accept any 2–6 letter program code in the registration number.
VIT_PROGRAM_CODES=
